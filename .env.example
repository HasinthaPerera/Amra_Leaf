# Database Connection URL (Server-side only)
# Replace credentials with your local or cloud PostgreSQL database connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/amra_leaf?schema=public"

# Email (SMTP) Configuration — Required for sending welcome emails to new employees
# Using Gmail: enable 2FA then generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="Amra Leaf Security <your-gmail@gmail.com>"

# App URL (used in email links — change to production URL when deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3000
